// Nastavení tempa na 174 BPM (standard pro DnB)
setcps(174/60/4)
const beatSec = 60/174   // one beat in seconds, for tempo-synced delays

// ---- 42-bar loop (~58 s), shaped like a run ----
// 0-11   CRUISE     driving around grabbing cash: lead riff, hats, clap, bass; pad from bar 6
// 12-17  HEAT       they've spotted you: 4/4 kick, open hats, siren two-tone; riser 15-17, fill on 17
// 18-26  CHASE A    crash -> two-step kick, sub, snare, arp
// 27-35  CHASE B    crash -> + brass stabs, lead hook, hat rolls
// 36-41  LOST THEM  drums thin out, arp + hook + pad carry it back to CRUISE
const leadBars   = "<1@18 0@24>"
const padBars    = "<0@6 1@36>"
const ohBars     = "<0@12 1@30>"
const heatBars   = "<0@12 1@6 0@24>"
const riserBars  = "<0@15 1@3 0@24>"
const fillBar    = "<0@17 1 0@24>"
const chaseBars  = "<0@18 1@18 0@6>"
const chaseBBars = "<0@27 1@9 0@6>"
const arpBars    = "<0@18 1@24>"
const hookBars   = "<0@27 1@15>"

// harmony: Dm7 -> Fmaj7 -> G7 (D dorian), one chord per bar
stack(
  // ---- drums ----
  s("bd:4*4").fast("<1@17 2 1@24>").gain(0.5).mask(heatBars),
  s("bd:4 ~ ~ ~ ~ bd:4 ~ <~!3 bd:4>").gain(0.55).mask(chaseBars),
  s("~ cp:2 ~ cp:2").gain(0.5),
  s("~ sd:3 ~ sd:3").gain(0.3).mask(chaseBars),
  s("sd*16").gain(saw.range(0.05, 0.45)).mask(fillBar),
  s("<~@18 cr:2 ~@8 cr:2 ~@14>").gain(0.45),

  s("~ ~ ~ oh ~ ~ ~ oh").gain(0.22).mask(ohBars),
  s("hh*8")
    .gain("[.3 .17]*4")
    .pan(sine.slow(4).range(0.3, 0.7))
    .sometimesBy("<0@27 0.25@9 0@6>", x => x.ply(2)),

  s("white*16")
    .decay(0.08).sustain(0)
    .hpf(saw.slow(3).range(400, 6000))
    .gain(saw.slow(3).range(0, 0.15))
    .mask(riserBars),

  // ---- siren: hi-lo two-tone, swelling through HEAT ----
  note("d5 a4")
    .s("square")
    .vib(6).vibmod(0.15)
    .lpf(1800)
    .room(0.5)
    .pan(0.7)
    .gain(saw.slow(6).range(0.03, 0.1))
    .mask(heatBars),

  // ---- bass ----
  note("<d2 f2 g2>")
    .struct("x ~ x [~ x] x x x ~")
    .s("gm_lead_8_bass_lead")
    .hpf(800)
    .lpf("<1200@6 1500@6 1900@3 2600@3 1500@24>")
    .room(0.3)
    .mask(leadBars),

  note("<d2 f2 g2>")
    .s("gm_slap_bass_1")
    .lpf(300)
    .gain(0.7),

  note("<d1 f1 g1>")
    .struct("x@5 x@3")
    .s("sine")
    .release(0.1)
    .gain(0.45)
    .mask(chaseBars),

  // ---- melodic ----
  note("<[d3 f3 a3 c4 d4 c4 a3 f3] [f3 a3 c4 e4 f4 e4 c4 a3] [g3 b3 d4 f4 g4 f4 d4 b3]>")
    .s("square")
    .release(0.15)
    .lpf(sine.slow(8).range(400, 2000))
    .lpq(4)
    .delay(0.25).delaytime(beatSec * 0.75).delayfeedback(0.35)
    .room(0.4)
    .pan(0.35)
    .gain(0.18)
    .mask(arpBars),

  note("<[d3,f3,a3,c4] [f3,a3,c4,e4] [g3,b3,d4,f4]>")
    .s("saw")
    .attack(0.3).release(1.5)
    .lpf(sine.slow(16).range(300, 800))
    .room(0.9).size(0.9)
    .gain(0.2)
    .mask(padBars),

  note("<[d3 ~ d4 ~ a3 ~ f3 ~] [f3 ~ f4 ~ c4 ~ a3 ~] [g3 ~ g4 ~ d4 ~ b3 ~]>")
    .s("saw, gm_synth_brass_1")
    .release(0.1)
    .lpf(saw.slow(2).range(500, 3000))
    .pan(0.65)
    .gain(0.14)
    .mask(chaseBBars),

  note("<[~ ~ d5 ~ ~ [c5 d5] f5 ~] [~ ~ c5 ~ ~ [a4 c5] e5 ~] [~ ~ b4 ~ ~ [a4 b4] d5 ~]>")
    .s("triangle")
    .release(0.4)
    .lpf(2400)
    .delay(0.4).delaytime(beatSec * 0.75).delayfeedback(0.4)
    .room(0.6).size(0.7)
    .gain(0.35)
    .mask(hookBars)
)
